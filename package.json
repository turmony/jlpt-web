    "eventemitter3": "5.0.1",
    "i18next": "23.7.16",
    "katex": "0.16.22",
    "mermaid": "11.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "14.0.5",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.8.0",
